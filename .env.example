# Supabase Postgres connection string (Project Settings > Database > Connection string)
# Use the "Transaction pooler" string for serverless deployments.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Admin panel (/admin) password — change before going live!
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie (any long random string)
SESSION_SECRET=change-me-too

# Paystack (online invoice payments) — optional here; can also be set from
# Admin > Payments, which takes priority over these. Set a webhook in the
# Paystack dashboard pointing to https://<your-domain>/api/webhooks/paystack.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Shared secret for scheduled jobs (Vercel Cron sends it as "Authorization: Bearer <value>").
# Required in production: /api/cron/daily and /api/cron/npa-sync refuse to run without it.
# Supabase Realtime for the job group chat (Project Settings > API). Both are public values.
# Without them the chat still works, checking for new messages every few seconds instead of live.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

CRON_SECRET=
